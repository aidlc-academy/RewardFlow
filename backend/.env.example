# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
RF_SESSION_SECRET=your-long-random-secret-here

# One-time owner account setup key
RF_SETUP_KEY=your-setup-key-here

# Firebase service account key path (optional — Firestore sync disabled if not set)
# Download from Firebase Console → Project Settings → Service Accounts
# GOOGLE_APPLICATION_CREDENTIALS=./rewardflow-firebase-adminsdk.json
